<!--
  KUKA LBR iiwa 14 with direct joint-torque actuators.

  Derived from assets/kuka_iiwa_14/iiwa14.xml (MuJoCo Menagerie, pinned commit
  0059d4335f8156206f63a35662313385f7ad6d74, BSD-3-Clause, see
  assets/kuka_iiwa_14/SOURCE.md). Kinematics, inertias, visual meshes, collision
  spheres and the adjacent-link <contact><exclude> list are copied verbatim.

  Changes relative to upstream:
    * meshdir is the assets directory; mesh paths are prefixed with kuka_iiwa_14/assets/.
    * <option> and the tracking light are removed; the scene file owns those.
    * The position-servo actuator defaults (<general gaintype="fixed"
      biastype="affine" gainprm="2000" biasprm="0 -2000 -200">) and the
      angle-valued <general ctrlrange> entries in the joint classes are removed.
    * The seven <general> position actuators are replaced by seven <motor>
      actuators with gear="1", one per joint in order, so ctrl[i] is the torque
      on joint (i+1) in N*m. ctrlrange sets the simulation torque limit.
    * The keyframe carries only qpos (no position-command ctrl values).
    * A site named "flange" is added at the flange centre of link7 and the
      polishing tool (polishing_tool.xml) is included there; it defines "tcp".

  Torque limits (N*m): 320 320 176 176 110 40 40. Source: KUKA LBR iiwa 14 R820
  technical data (joint torque limits A1..A7), the same spec sheet cited by the
  upstream Menagerie README. They are used here as simulation settings only;
  nothing in this project certifies them against hardware.
-->
<mujoco model="iiwa14_torque">
  <compiler angle="radian" meshdir="." autolimits="true"/>

  <default>
    <default class="iiwa">
      <material specular="0.5" shininess="0.25"/>
      <joint axis="0 0 1"/>
      <default class="joint1">
        <joint range="-2.96706 2.96706"/>
        <default class="joint2">
          <joint range="-2.0944 2.0944"/>
        </default>
      </default>
      <default class="joint3">
        <joint range="-3.05433 3.05433"/>
      </default>
      <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2" material="gray"/>
      </default>
      <default class="collision">
        <geom group="3"/>
      </default>
      <site size="0.001" rgba="1 0 0 1" group="4"/>
    </default>
  </default>

  <asset>
    <material class="iiwa" name="gray" rgba="0.4 0.4 0.4 1"/>
    <material class="iiwa" name="light_gray" rgba="0.6 0.6 0.6 1"/>
    <material class="iiwa" name="black" rgba="0 0 0 1"/>
    <material class="iiwa" name="orange" rgba="1 0.423529 0.0392157 1"/>

    <mesh file="kuka_iiwa_14/assets/link_0.obj"/>
    <mesh file="kuka_iiwa_14/assets/link_1.obj"/>
    <mesh file="kuka_iiwa_14/assets/link_2_orange.obj"/>
    <mesh file="kuka_iiwa_14/assets/link_2_grey.obj"/>
    <mesh file="kuka_iiwa_14/assets/link_3.obj"/>
    <mesh file="kuka_iiwa_14/assets/band.obj"/>
    <mesh file="kuka_iiwa_14/assets/kuka.obj"/>
    <mesh file="kuka_iiwa_14/assets/link_4_orange.obj"/>
    <mesh file="kuka_iiwa_14/assets/link_4_grey.obj"/>
    <mesh file="kuka_iiwa_14/assets/link_5.obj"/>
    <mesh file="kuka_iiwa_14/assets/link_6_orange.obj"/>
    <mesh file="kuka_iiwa_14/assets/link_6_grey.obj"/>
    <mesh file="kuka_iiwa_14/assets/link_7.obj"/>

    <!-- Polishing tool (assets/polishing_tool/SOURCE.md) -->
    <material name="tool_black" rgba="0.12 0.12 0.12 1" specular="0.3" shininess="0.3"/>
    <material name="tool_steel" rgba="0.70 0.70 0.72 1" specular="0.6" shininess="0.5"/>
    <mesh name="ft_sensor" file="polishing_tool/ft_sensor.stl"/>
    <mesh name="sphere_tool" file="polishing_tool/sphere_tool.stl"/>
  </asset>

  <worldbody>
    <!-- Robot base frame coincides with the world frame (mounting plate at the origin). -->
    <body name="base" childclass="iiwa">
      <inertial mass="5" pos="-0.1 0 0.07" diaginertia="0.05 0.06 0.03"/>
      <geom class="visual" mesh="link_0"/>
      <geom class="collision" size="0.12" pos="0 0 0.03"/>
      <geom class="collision" size="0.08" pos="-0.08 0 0.103"/>
      <geom class="collision" size="0.08" pos="-0.08 0 0.04"/>
      <geom class="collision" size="0.1" pos="0 0 0.14"/>
      <body name="link1" pos="0 0 0.1575">
        <inertial mass="5.76" pos="0 -0.03 0.12" diaginertia="0.0333 0.033 0.0123"/>
        <joint name="joint1" class="joint1"/>
        <geom class="visual" mesh="link_1"/>
        <geom class="collision" size="0.08" pos="0 0 -0.0005"/>
        <geom class="collision" size="0.075" pos="0.01 -0.025 0.0425"/>
        <geom class="collision" size="0.075" pos="-0.01 -0.025 0.0425"/>
        <geom class="collision" size="0.07" pos="0.01 -0.045 0.1025"/>
        <geom class="collision" size="0.07" pos="-0.01 -0.045 0.1025"/>
        <body name="link2" pos="0 0 0.2025" quat="0 0 1 1">
          <inertial mass="6.35" pos="0.0003 0.059 0.042" diaginertia="0.0305 0.0304 0.011" quat="0 0 1 1"/>
          <joint name="joint2" class="joint2"/>
          <geom class="visual" material="orange" mesh="link_2_orange"/>
          <geom class="visual" mesh="link_2_grey"/>
          <geom class="collision" size="0.095" pos="0 0 -0.01"/>
          <geom class="collision" size="0.09" pos="0 0 0.045"/>
          <geom class="collision" size="0.07" pos="-0.01 0.04 0.054"/>
          <geom class="collision" size="0.065" pos="-0.01 0.09 0.04"/>
          <geom class="collision" size="0.065" pos="-0.01 0.13 0.02"/>
          <geom class="collision" size="0.07" pos="0.01 0.04 0.054"/>
          <geom class="collision" size="0.065" pos="0.01 0.09 0.04"/>
          <geom class="collision" size="0.065" pos="0.01 0.13 0.02"/>
          <geom class="collision" size="0.075" pos="0 0.18 0"/>
          <body name="link3" pos="0 0.2045 0" quat="0 0 1 1">
            <inertial mass="3.5" pos="0 0.03 0.13" diaginertia="0.025 0.0238 0.0076"/>
            <joint name="joint3" class="joint1"/>
            <geom class="visual" mesh="link_3"/>
            <geom class="visual" material="light_gray" mesh="band"/>
            <geom class="visual" material="black" mesh="kuka"/>
            <geom class="collision" size="0.075" pos="0 0 0.0355"/>
            <geom class="collision" size="0.06" pos="0.01 0.023 0.0855"/>
            <geom class="collision" size="0.055" pos="0.01 0.048 0.1255"/>
            <geom class="collision" size="0.06" pos="0.01 0.056 0.1755"/>
            <geom class="collision" size="0.06" pos="-0.01 0.023 0.0855"/>
            <geom class="collision" size="0.055" pos="-0.01 0.048 0.1255"/>
            <geom class="collision" size="0.06" pos="-0.01 0.056 0.1755"/>
            <geom class="collision" size="0.075" pos="0 0.045 0.2155"/>
            <geom class="collision" size="0.075" pos="0 0 0.2155"/>
            <body name="link4" pos="0 0 0.2155" quat="1 1 0 0">
              <inertial mass="3.5" pos="0 0.067 0.034" diaginertia="0.017 0.0164 0.006" quat="1 1 0 0"/>
              <joint name="joint4" class="joint2"/>
              <geom class="visual" material="orange" mesh="link_4_orange"/>
              <geom class="visual" mesh="link_4_grey"/>
              <geom class="collision" size="0.078" pos="0 0.01 0.046"/>
              <geom class="collision" size="0.06" pos="0.01 0.06 0.052"/>
              <geom class="collision" size="0.065" pos="0.01 0.12 0.034"/>
              <geom class="collision" size="0.06" pos="-0.01 0.06 0.052"/>
              <geom class="collision" size="0.065" pos="-0.01 0.12 0.034"/>
              <geom class="collision" size="0.075" pos="0 0.184 0"/>
              <body name="link5" pos="0 0.1845 0" quat="0 0 1 1">
                <inertial mass="3.5" pos="0.0001 0.021 0.076" diaginertia="0.01 0.0087 0.00449"/>
                <joint name="joint5" class="joint1"/>
                <geom class="visual" mesh="link_5"/>
                <geom class="visual" material="light_gray" mesh="band"/>
                <geom class="visual" material="black" mesh="kuka"/>
                <geom class="collision" size="0.075" pos="0 0 0.0335"/>
                <geom class="collision" size="0.05" pos="-0.012 0.031 0.0755"/>
                <geom class="collision" size="0.05" pos="0.012 0.031 0.0755"/>
                <geom class="collision" size="0.04" pos="-0.012 0.06 0.1155"/>
                <geom class="collision" size="0.04" pos="0.012 0.06 0.1155"/>
                <geom class="collision" size="0.04" pos="-0.01 0.065 0.1655"/>
                <geom class="collision" size="0.04" pos="0.01 0.065 0.1655"/>
                <geom class="collision" size="0.035" pos="-0.012 0.065 0.1855"/>
                <geom class="collision" size="0.035" pos="0.012 0.065 0.1855"/>
                <body name="link6" pos="0 0 0.2155" quat="1 1 0 0">
                  <inertial mass="1.8" pos="0 0.0006 0.0004" diaginertia="0.0049 0.0047 0.0036" quat="1 1 0 0"/>
                  <joint name="joint6" class="joint2"/>
                  <geom class="visual" material="orange" mesh="link_6_orange"/>
                  <geom class="visual" mesh="link_6_grey"/>
                  <geom class="collision" size="0.055" pos="0 0 -0.059"/>
                  <geom class="collision" size="0.065" pos="0 -0.03 0.011"/>
                  <geom class="collision" size="0.08"/>
                  <body name="link7" pos="0 0.081 0" quat="0 0 1 1">
                    <inertial mass="1.2" pos="0 0 0.02" diaginertia="0.001 0.001 0.001"/>
                    <joint name="joint7" class="joint3"/>
                    <geom class="visual" mesh="link_7"/>
                    <geom class="collision" size="0.06" pos="0 0 0.001"/>
                    <!-- Upstream flange site, kept for compatibility with Menagerie tooling. -->
                    <site pos="0 0 0.045" name="attachment_site"/>
                    <!-- Flange frame: origin at the centre of the mounting face, 0.045 m along
                         the joint-7 axis from the link7 origin, z-axis pointing out of the
                         flange, x/y axes aligned with the link7 frame. -->
                    <site name="flange" pos="0 0 0.045" size="0.004" rgba="1 1 0 1" group="1"/>
                    <!-- Polishing tool stack; defines the `tcp` site at the tip sphere centre. -->
                    <include file="polishing_tool.xml"/>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <!-- Upstream adjacent-link exclusions, kept verbatim. Everything else collides. -->
  <contact>
    <exclude body1="base" body2="link1"/>
    <exclude body1="base" body2="link2"/>
    <exclude body1="base" body2="link3"/>
    <exclude body1="link1" body2="link3"/>
    <exclude body1="link3" body2="link5"/>
    <exclude body1="link4" body2="link7"/>
    <exclude body1="link5" body2="link7"/>
  </contact>

  <!-- Direct joint-torque actuators: ctrl[i] (N*m) -> joint(i+1), gear = 1. -->
  <actuator>
    <motor name="joint1_torque" joint="joint1" gear="1" ctrlrange="-320 320"/>
    <motor name="joint2_torque" joint="joint2" gear="1" ctrlrange="-320 320"/>
    <motor name="joint3_torque" joint="joint3" gear="1" ctrlrange="-176 176"/>
    <motor name="joint4_torque" joint="joint4" gear="1" ctrlrange="-176 176"/>
    <motor name="joint5_torque" joint="joint5" gear="1" ctrlrange="-110 110"/>
    <motor name="joint6_torque" joint="joint6" gear="1" ctrlrange="-40 40"/>
    <motor name="joint7_torque" joint="joint7" gear="1" ctrlrange="-40 40"/>
  </actuator>

  <!-- Force/torque sensor at the FT-sensor top face. MuJoCo reports the interaction
       wrench between the `ft_sensor` body (plus everything below it: shaft and tip)
       and its parent, expressed in the ft_site frame. The reading therefore includes
       the tool's own weight (0.50 kg) and must be bias-compensated to obtain the
       contact force; see kuka_table_sim/force_control.py. -->
  <sensor>
    <force name="ft_force" site="ft_site"/>
    <torque name="ft_torque" site="ft_site"/>
  </sensor>

  <!-- Initial configuration (rad), joints 1..7. ctrl is intentionally omitted:
       the holding controller writes torques, so the keyframe stores no commands. -->
  <keyframe>
    <key name="home" qpos="0 0.43 0 -1.51 0 1.2 0"/>
  </keyframe>
</mujoco>
