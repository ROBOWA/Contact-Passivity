<mujoco model="planar_two_link_slider">
  <!--
    Planar two-link robot in the vertical x-z plane.

    Conventions:
      * World z points UP. Gravity is -z.
      * The horizontal contact surface top face is at z = 0.
      * Both joints are hinges about the world/local y axis, so all motion
        stays in the x-z plane (the robot has no y DOF by construction).
      * Zero configuration: both links point along +x. Positive hinge angle
        about +y rotates a link's +x direction toward -z (downward).

    Integrator / contact configuration:
      * integrator="implicitfast": implicit-in-velocity integration, the
        recommended stable choice in MuJoCo >= 3 for models with joint
        damping. Timestep 1 ms.
      * Contacts use condim="3" (one normal + two tangential friction
        directions), elliptic-cone-compatible default pyramidal solver.
      * solref="0.08 1.5", solimp="0.2 0.7 0.02": a deliberately soft,
        overdamped contact. Stiffer settings (e.g. solref="0.01 1") put the
        pad-contact resonance near 100 Hz, and the delayed force feedback
        sustained a micro-bouncing limit cycle (contact active only ~50-90%
        of steps, F_n oscillating 0-16 N). With this soft setting the pad
        stays in continuous contact (100% of sliding steps), steady
        penetration at F_d = 5 N is ~1.3 mm, and F_n holds 5.00 +/- 0.01 N.

    Collision filtering:
      * surface and end_effector_pad: contype=1 conaffinity=1.
      * every other geom: contype=0 conaffinity=0 (collisions disabled).
      => The ONLY possible contact pair is (surface, end_effector_pad).
  -->
  <compiler angle="radian" autolimits="true"/>

  <option timestep="0.001" integrator="implicitfast" gravity="0 0 -9.81">
    <flag energy="enable"/>
  </option>

  <default>
    <joint type="hinge" axis="0 1 0" damping="0.1"/>
    <geom contype="0" conaffinity="0" condim="3"
          friction="0.3 0.005 0.0001" solref="0.08 1.5" solimp="0.2 0.7 0.02"/>
    <motor ctrlrange="-60 60"/>
  </default>

  <visual>
    <global offwidth="1280" offheight="720"/>
  </visual>

  <worldbody>
    <light name="main_light" pos="0.5 -1.5 2.0" dir="-0.2 0.6 -0.8" diffuse="0.9 0.9 0.9"/>

    <!-- Horizontal contact surface, top face exactly at z = 0. -->
    <geom name="surface" type="box" pos="1.0 0 -0.05" size="1.5 0.5 0.05"
          contype="1" conaffinity="1" rgba="0.55 0.55 0.6 1"/>

    <!-- Robot base ("shoulder") mounted above the surface. -->
    <body name="base" pos="0 0 0.7">
      <geom name="base_geom" type="cylinder" fromto="0 -0.07 0 0 0.07 0"
            size="0.06" mass="1.0" rgba="0.3 0.3 0.35 1"/>

      <body name="link1" pos="0 0 0">
        <joint name="shoulder" range="-1.9 1.9"/>
        <geom name="link1_geom" type="capsule" fromto="0 0 0 0.6 0 0"
              size="0.040" mass="2.0" rgba="0.16 0.47 0.84 1"/>

        <body name="link2" pos="0.6 0 0">
          <joint name="elbow" range="0.15 2.9"/>
          <geom name="link2_geom" type="capsule" fromto="0 0 0 0.6 0 0"
                size="0.035" mass="1.5" rgba="0.92 0.41 0.20 1"/>

          <!-- Spherical end-effector pad: the ONLY robot geom that can
               touch the surface. -->
          <geom name="end_effector_pad" type="sphere" pos="0.6 0 0" size="0.05"
                contype="1" conaffinity="1" mass="0.3" rgba="0.11 0.69 0.48 1"/>
          <site name="ee_site" pos="0.6 0 0" size="0.012" rgba="1 1 0 1"/>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor name="shoulder_motor" joint="shoulder"/>
    <motor name="elbow_motor" joint="elbow"/>
  </actuator>

  <!-- Initial pose: end-effector pad center at ~(0.35, 0, 0.15), i.e. 10 cm
       above touch height (pad radius 0.05), elbow bent ~114 deg (nonsingular),
       computed from two-link IK for base (0,0,0.7), L1 = L2 = 0.6. -->
  <keyframe>
    <key name="init" qpos="0.0076 1.9930"/>
  </keyframe>
</mujoco>
